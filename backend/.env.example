# OmniTrans Backend Environment Variables

# TTS Engine Selection: edge | gtts | xtts
TTS_PROVIDER=edge

# Default Target Language for dubbing & translation
DEFAULT_TARGET_LANGUAGE=es

# Time Synchronization Bounds (1.0 = normal speed, 1.5 = max 50% speedup, 0.75 = min 25% slowdown)
MAX_TIME_STRETCH_RATIO=1.50
MIN_TIME_STRETCH_RATIO=0.75

# Background Music & Voice Separation (Requires demucs package if set to true)
USE_DEMUCS=false
DEMUCS_MODEL=htdemucs

# Background Audio Ducking Level in dB (e.g. -15 means reduce original audio by 15dB under dubbed voice)
AUDIO_DUCKING_DB=-15

# Optional HuggingFace Token for pyannote.audio speaker diarization
# HUGGINGFACE_TOKEN=hf_your_token_here

